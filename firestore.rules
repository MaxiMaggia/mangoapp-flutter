rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDoc() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn()
        && request.auth.uid == userId;
    }

    match /categories/{categoryId} {
      allow get, list: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc();
      allow delete: if ownsExistingDoc();
    }

    match /expenses/{expenseId} {
      allow get, list: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc();
      allow delete: if ownsExistingDoc();
    }
  }
}
